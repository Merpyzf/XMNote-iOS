    "schemaFingerprint": "055724e3c2ec28094f771961e2df1cf807efc99ac26f87e9d7308377d9b8eab2"
  },
  "runtimeProfile": {
    "sha256": "${RUNTIME_PROFILE_SHA256}",
    "requiredSettings": []
  },
  "aliases": [
    {
      "name": "activeBook",
      "entity": "book",
      "description": "同时使用旧作者名与旧出版社名的有效书",
      "requirements": [
        "is_deleted=0",
        "author=oldAuthor.name",
        "press=oldPublisher.name",
        "id 小于 deletedBook"
      ],
      "selector": "active-book"
    },
    {
      "name": "deletedBook",
      "entity": "book",
      "description": "仍保留旧作者名与旧出版社名的历史 tombstone 书",
      "requirements": [
        "is_deleted!=0",
        "author=oldAuthor.name",
        "press=oldPublisher.name",
        "id 大于 activeBook"
      ]
    },
    {
      "name": "oldAuthor",
      "entity": "author",
      "description": "被合并的旧作者记录",
      "requirements": [
        "is_deleted=0",
        "name!=targetAuthor.name"
      ]
    },
    {
      "name": "targetAuthor",
      "entity": "author",
      "description": "合并后的目标作者记录",
      "requirements": [
        "is_deleted=0",
        "name!=oldAuthor.name"
      ]
    },
    {
      "name": "oldPublisher",
      "entity": "publisher",
      "description": "被合并的旧出版社记录",
      "requirements": [
        "is_deleted=0",
        "name!=targetPublisher.name"
      ]
    },
    {
      "name": "targetPublisher",
      "entity": "publisher",
      "description": "合并后的目标出版社记录",
      "requirements": [
        "is_deleted=0",
        "name!=oldPublisher.name"
      ]
    }
  ],
  "intent": {
    "summary": "把 oldAuthor 合并到 targetAuthor，再把 oldPublisher 合并到 targetPublisher",
    "selectionScope": "batch",
    "confirmation": "required",
    "outcome": "committed",
    "repeatTrigger": "once",
    "selectedAliases": [
      "oldAuthor",
      "oldPublisher"
    ]
  },
  "adapters": {
    "android": {
      "entry": "作者管理与出版社管理的合并入口",
      "steps": [
        {
          "action": "打开管理页并稳定读取",
          "checkpoint": "S1"
        },
        {
          "action": "选择旧记录与目标记录",
          "checkpoint": "S2"
        },
        {
          "action": "依次确认作者合并与出版社合并",
          "checkpoint": "S3"
        },
        {
          "action": "host force-stop .uitest 后以 resume 模式冷启动读取",
          "checkpoint": "S4"
        }
      ]
    },
    "ios": {
      "entry": "Repository 合同适配器；当前无等价多选管理入口",
      "steps": [
        {
          "action": "创建等价 Repository 读取上下文",
          "checkpoint": "S1"
        },
        {
          "action": "绑定旧记录与目标记录",
          "checkpoint": "S2"
        },
        {
          "action": "依次执行作者名与出版社名合并命令",
          "checkpoint": "S3"
        },
        {
          "action": "host 终止 App 后以同一副本冷启动读取",
          "checkpoint": "S4"
        }
      ]
    }
  },
