      }
    ],
    "strictExceptions": []
  },
  "setup": {
    "mode": "none"
  },
  "oracle": {
    "currentOracle": "作者与出版社合并在事务内只更新有效书籍；历史已删除书籍保持原作者和出版社文本不变。",
    "desiredSemantics": "作者与出版社合并在事务内只更新有效书籍；历史已删除书籍保持原作者和出版社文本不变。",
    "semanticProjections": [
      {
        "name": "merged-book-name-owners",
        "description": "通过管理表名称反查，把书籍文本规范化成作者和出版社逻辑 ID",
        "sql": "SELECT b.id AS book_id, CASE WHEN b.author = (SELECT name FROM author WHERE id = :targetAuthor) THEN :targetAuthor WHEN b.author = (SELECT name FROM author WHERE id = :oldAuthor) THEN :oldAuthor END AS author_id, CASE WHEN b.press = (SELECT name FROM press WHERE id = :targetPublisher) THEN :targetPublisher WHEN b.press = (SELECT name FROM press WHERE id = :oldPublisher) THEN :oldPublisher END AS publisher_id FROM book AS b WHERE b.id IN (:activeBook, :deletedBook) ORDER BY b.id",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "book_id",
            "aliasEntity": "book"
          },
          {
            "name": "author_id",
            "aliasEntity": "author"
          },
          {
            "name": "publisher_id",
            "aliasEntity": "publisher"
          }
        ],
        "parameters": {
          "activeBook": {
            "binding": "activeBook"
          },
          "deletedBook": {
            "binding": "deletedBook"
          },
          "oldAuthor": {
            "binding": "oldAuthor"
          },
          "targetAuthor": {
            "binding": "targetAuthor"
          },
          "oldPublisher": {
            "binding": "oldPublisher"
          },
          "targetPublisher": {
            "binding": "targetPublisher"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": [
            {
              "book_id": "activeBook",
              "author_id": "oldAuthor",
              "publisher_id": "oldPublisher"
            },
            {
              "book_id": "deletedBook",
              "author_id": "oldAuthor",
              "publisher_id": "oldPublisher"
            }
          ],
          "iosBefore": [
            {
              "book_id": "activeBook",
              "author_id": "oldAuthor",
              "publisher_id": "oldPublisher"
            },
            {
              "book_id": "deletedBook",
              "author_id": "oldAuthor",
              "publisher_id": "oldPublisher"
            }
          ],
          "androidAfter": [
            {
              "book_id": "activeBook",
              "author_id": "targetAuthor",
              "publisher_id": "targetPublisher"
            },
            {
              "book_id": "deletedBook",
              "author_id": "oldAuthor",
              "publisher_id": "oldPublisher"
            }
          ],
          "iosAfter": [
            {
              "book_id": "activeBook",
              "author_id": "targetAuthor",
              "publisher_id": "targetPublisher"
            },
            {
              "book_id": "deletedBook",
              "author_id": "oldAuthor",
              "publisher_id": "oldPublisher"
            }
          ]
        }
      }
    ]
  },
