  "aliases": [
    {
      "name": "sourceGroup",
      "entity": "group",
      "description": "包含三本目标书的有效分组",
      "requirements": [
        "is_deleted=0",
        "至少包含三条目标有效关系"
      ],
      "selector": "active-non-empty-group"
    },
    {
      "name": "inputBookA",
      "entity": "book",
      "description": "输入集合中的第一本有效书",
      "requirements": [
        "is_deleted=0",
        "有效关系指向 sourceGroup",
        "id 小于 inputBookB"
      ]
    },
    {
      "name": "inputBookB",
      "entity": "book",
      "description": "输入集合中的第二本有效书",
      "requirements": [
        "is_deleted=0",
        "有效关系指向 sourceGroup",
        "id 介于 A 与 C"
      ]
    },
    {
      "name": "inputBookC",
      "entity": "book",
      "description": "输入集合中的第三本有效书",
      "requirements": [
        "is_deleted=0",
        "有效关系指向 sourceGroup",
        "id 大于 inputBookB"
      ]
    }
  ],
  "intent": {
    "summary": "按 A、B、C 的选择顺序批量移出 sourceGroup，并选择放到默认书架开头",
    "selectionScope": "batch",
    "confirmation": "required",
    "outcome": "committed",
    "repeatTrigger": "once",
    "selectedAliases": [
      "inputBookA",
      "inputBookB",
      "inputBookC"
    ]
  },
  "adapters": {
    "android": {
      "entry": "分组书籍页批量移出入口",
      "steps": [
        {
          "action": "打开 sourceGroup 并稳定读取",
          "targetAlias": "sourceGroup",
          "checkpoint": "S1"
        },
        {
          "action": "按 A、B、C 选择三本书并选择放到开头",
          "checkpoint": "S2"
        },
        {
          "action": "确认移出",
          "checkpoint": "S3"
        },
        {
          "action": "host force-stop .uitest 后以 resume 模式冷启动读取",
          "checkpoint": "S4"
        }
      ]
    },
    "ios": {
      "entry": "原生分组书籍列表编辑 accessory 的移出入口",
      "steps": [
        {
          "action": "打开 sourceGroup 并稳定读取",
          "targetAlias": "sourceGroup",
          "checkpoint": "S1"
        },
        {
          "action": "按 A、B、C 选择三本书并选择放到开头",
          "checkpoint": "S2"
        },
        {
          "action": "确认移出",
          "checkpoint": "S3"
        },
        {
          "action": "host 终止 App 后以同一副本冷启动读取",
          "checkpoint": "S4"
        }
      ]
    }
  },
