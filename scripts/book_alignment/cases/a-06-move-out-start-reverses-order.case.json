  "oracle": {
    "currentOracle": "输入 A、B、C 批量移到默认书架开头后仍保持 A、B、C 的相对顺序；分组关系在同一事务内物理删除。",
    "desiredSemantics": "输入 A、B、C 批量移到默认书架开头后仍保持 A、B、C 的相对顺序；分组关系在同一事务内物理删除。",
    "semanticProjections": [
      {
        "name": "selected-default-order",
        "description": "只比较三本目标书按 book_order 读取的相对顺序",
        "sql": "SELECT id AS book_id FROM book WHERE id IN (:bookA, :bookB, :bookC) AND is_deleted = 0 ORDER BY book_order, id",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "book_id",
            "aliasEntity": "book"
          }
        ],
        "parameters": {
          "bookA": {
            "binding": "inputBookA"
          },
          "bookB": {
            "binding": "inputBookB"
          },
          "bookC": {
            "binding": "inputBookC"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidAfter": [
            {
              "book_id": "inputBookA"
            },
            {
              "book_id": "inputBookB"
            },
            {
              "book_id": "inputBookC"
            }
          ],
          "iosAfter": [
            {
              "book_id": "inputBookA"
            },
            {
              "book_id": "inputBookB"
            },
            {
              "book_id": "inputBookC"
            }
          ]
        }
      },
      {
        "name": "active-source-relations",
        "description": "提交后三本书均无 sourceGroup 有效关系",
        "sql": "SELECT COUNT(*) AS active_count FROM group_book WHERE group_id = :sourceGroup AND book_id IN (:bookA, :bookB, :bookC) AND is_deleted = 0",
        "mode": "scalar",
        "columns": [
          {
            "name": "active_count"
          }
        ],
        "parameters": {
          "sourceGroup": {
            "binding": "sourceGroup"
          },
          "bookA": {
            "binding": "inputBookA"
          },
          "bookB": {
            "binding": "inputBookB"
          },
          "bookC": {
            "binding": "inputBookC"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": 3,
          "iosBefore": 3,
          "androidAfter": 0,
          "iosAfter": 0
        }
      }
    ]
  },
