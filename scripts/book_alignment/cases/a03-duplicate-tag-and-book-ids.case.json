{
  "schemaVersion": 1,
  "caseId": "a03.duplicate-tag-and-book-ids",
  "title": "A-03 重复标签与书籍 ID 输入按稳定顺序去重",
  "status": "exact-current",
  "baseline": {
    "sha256": "${B0_SHA256}",
