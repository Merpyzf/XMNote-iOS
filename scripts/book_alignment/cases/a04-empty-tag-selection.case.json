        {
          "action": "关闭并重开 Room 后重新读取",
          "checkpoint": "S4"
        }
      ]
    },
    "ios": {
      "entry": "原生单本与批量标签 Sheet",
      "steps": [
        {
          "action": "打开隔离副本",
          "checkpoint": "S1"
        },
        {
          "action": "准备等价且互不重叠的关系",
          "checkpoint": "S2"
        },
        {
          "action": "各自在单一 GRDB 写事务中提交空选择",
          "checkpoint": "S3"
        },
        {
          "action": "终止 App 后以同一副本冷启动读取",
          "checkpoint": "S4"
        }
      ]
    }
  },
  "database": {
