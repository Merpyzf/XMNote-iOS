  "runtimeProfile": {
    "sha256": "${RUNTIME_PROFILE_SHA256}",
    "requiredSettings": []
  },
  "aliases": [
    {
      "name": "singleBook",
      "entity": "book",
      "description": "空标签选择走单本替换分支的有效书",
      "requirements": [
        "is_deleted=0",
        "S2 时仅有 singleExistingTag"
      ],
      "selector": "active-book"
    },
    {
      "name": "batchBookA",
      "entity": "book",
      "description": "空标签选择走多本分支的第一本有效书",
      "requirements": [
        "is_deleted=0",
        "S2 时有 batchExistingTag"
      ],
      "selector": "active-book"
    },
    {
      "name": "batchBookB",
      "entity": "book",
      "description": "空标签选择走多本分支的第二本有效书",
      "requirements": [
        "is_deleted=0",
        "S2 时有 batchExistingTag"
      ],
      "selector": "active-book"
    },
    {
      "name": "singleExistingTag",
      "entity": "tag",
      "description": "单本操作前已有并会被清空的标签",
      "requirements": [
        "is_deleted=0",
        "id!=batchExistingTag"
      ]
    },
    {
      "name": "batchExistingTag",
      "entity": "tag",
      "description": "两本批量目标操作前共同已有且应保留的标签",
      "requirements": [
        "is_deleted=0",
        "id!=singleExistingTag"
      ]
    }
  ],
  "intent": {
    "summary": "在同一场景的两份互不重叠 fixture 上依次提交单本空标签与多本空标签命令",
    "selectionScope": "batch",
    "confirmation": "required",
    "outcome": "committed",
    "repeatTrigger": "once",
    "selectedAliases": [
      "singleBook",
      "batchBookA",
      "batchBookB"
    ]
  },
  "adapters": {
    "android": {
      "entry": "单本与批量整理的标签选择入口",
      "steps": [
        {
          "action": "打开隔离副本",
          "checkpoint": "S1"
        },
        {
          "action": "准备互不重叠的单本与多本标签关系",
          "checkpoint": "S2"
        },
        {
          "action": "通过真实 Repository 依次提交两次空选择",
          "checkpoint": "S3"
