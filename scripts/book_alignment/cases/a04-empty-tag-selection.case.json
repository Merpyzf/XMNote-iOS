  "oracle": {
    "currentOracle": "单本 REPLACE 空选择在事务内物理清空全部标签；批量 ADD 空选择为 no-op 并保留原关系。",
    "desiredSemantics": "单本 REPLACE 空选择在事务内物理清空全部标签；批量 ADD 空选择为 no-op 并保留原关系。",
    "semanticProjections": [
      {
        "name": "active-empty-selection-relations",
        "description": "比较三本书空选择前后的有效标签关系",
        "sql": "SELECT book_id, tag_id FROM tag_book WHERE book_id IN (:singleBook, :batchBookA, :batchBookB) AND tag_id IN (:singleExistingTag, :batchExistingTag) AND is_deleted = 0 ORDER BY book_id, tag_id",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "book_id",
            "aliasEntity": "book"
          },
          {
            "name": "tag_id",
            "aliasEntity": "tag"
          }
        ],
        "parameters": {
          "singleBook": {
            "binding": "singleBook"
          },
          "batchBookA": {
            "binding": "batchBookA"
          },
          "batchBookB": {
            "binding": "batchBookB"
          },
          "singleExistingTag": {
            "binding": "singleExistingTag"
          },
          "batchExistingTag": {
            "binding": "batchExistingTag"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": [
            {
              "book_id": "singleBook",
              "tag_id": "singleExistingTag"
            },
            {
              "book_id": "batchBookA",
              "tag_id": "batchExistingTag"
            },
            {
              "book_id": "batchBookB",
              "tag_id": "batchExistingTag"
            }
          ],
          "iosBefore": [
            {
              "book_id": "singleBook",
              "tag_id": "singleExistingTag"
            },
            {
              "book_id": "batchBookA",
              "tag_id": "batchExistingTag"
            },
            {
              "book_id": "batchBookB",
              "tag_id": "batchExistingTag"
            }
          ],
          "androidAfter": [
            {
              "book_id": "batchBookA",
              "tag_id": "batchExistingTag"
            },
            {
              "book_id": "batchBookB",
              "tag_id": "batchExistingTag"
            }
          ],
          "iosAfter": [
            {
              "book_id": "batchBookA",
              "tag_id": "batchExistingTag"
            },
            {
              "book_id": "batchBookB",
              "tag_id": "batchExistingTag"
            }
          ]
        }
      },
      {
        "name": "single-old-relation-physical-count",
        "description": "两端均物理移除单本旧关系",
        "sql": "SELECT COUNT(*) AS row_count FROM tag_book WHERE book_id = :singleBook AND tag_id = :singleExistingTag",
        "mode": "scalar",
        "columns": [
          {
            "name": "row_count"
          }
        ],
        "parameters": {
          "singleBook": {
            "binding": "singleBook"
          },
          "singleExistingTag": {
            "binding": "singleExistingTag"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": 1,
          "iosBefore": 1,
          "androidAfter": 0,
          "iosAfter": 0
        }
      }
    ]
  },
