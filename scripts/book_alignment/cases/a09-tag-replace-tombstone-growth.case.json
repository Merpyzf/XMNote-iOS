  "oracle": {
    "currentOracle": "连续执行 A、B、A 三次 REPLACE 后，两端均只保留一条指向 replacementTagA 的物理有效关系，且不存在 tombstone。",
    "desiredSemantics": "连续执行 A、B、A 三次 REPLACE 后，两端均只保留一条指向 replacementTagA 的物理有效关系，且不存在 tombstone。",
    "semanticProjections": [
      {
        "name": "target-book-tag-row-counts",
        "description": "目标书的物理、删除和有效关系数量",
        "sql": "SELECT COUNT(*) AS physical_count, SUM(CASE WHEN is_deleted != 0 THEN 1 ELSE 0 END) AS deleted_count, SUM(CASE WHEN is_deleted = 0 THEN 1 ELSE 0 END) AS active_count FROM tag_book WHERE book_id = :targetBook",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "physical_count"
          },
          {
            "name": "deleted_count"
          },
          {
            "name": "active_count"
          }
        ],
        "parameters": {
          "targetBook": {
            "binding": "targetBook"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": [
            {
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ],
          "iosBefore": [
            {
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ],
          "androidAfter": [
            {
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ],
          "iosAfter": [
            {
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ]
        }
      },
      {
        "name": "target-book-tag-lifecycle",
        "description": "按标签冻结删除、重建、再次删除后的物理行与有效行分布",
        "sql": "SELECT tag_id, COUNT(*) AS physical_count, SUM(CASE WHEN is_deleted != 0 THEN 1 ELSE 0 END) AS deleted_count, SUM(CASE WHEN is_deleted = 0 THEN 1 ELSE 0 END) AS active_count FROM tag_book WHERE book_id = :targetBook GROUP BY tag_id ORDER BY tag_id",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "tag_id",
            "aliasEntity": "tag"
          },
          {
            "name": "physical_count"
          },
          {
            "name": "deleted_count"
          },
          {
            "name": "active_count"
          }
        ],
        "parameters": {
          "targetBook": {
            "binding": "targetBook"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": [
            {
              "tag_id": "originalTag",
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ],
          "iosBefore": [
            {
              "tag_id": "originalTag",
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ],
          "androidAfter": [
            {
              "tag_id": "replacementTagA",
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ],
          "iosAfter": [
            {
              "tag_id": "replacementTagA",
              "physical_count": 1,
              "deleted_count": 0,
              "active_count": 1
            }
          ]
        }
      },
      {
        "name": "target-book-final-active-tag",
        "description": "三次替换后两端有效关系都唯一指向标签 A",
        "sql": "SELECT tag_id FROM tag_book WHERE book_id = :targetBook AND is_deleted = 0 ORDER BY tag_id",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "tag_id",
            "aliasEntity": "tag"
          }
        ],
        "parameters": {
          "targetBook": {
            "binding": "targetBook"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidAfter": [
            {
              "tag_id": "replacementTagA"
            }
          ],
          "iosAfter": [
            {
              "tag_id": "replacementTagA"
            }
          ]
        }
      }
    ]
