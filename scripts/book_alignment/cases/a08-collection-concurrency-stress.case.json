  "adapters": {
    "android": {
      "entry": "test-only CollectionBookRepository 并发压力入口",
      "steps": [
        {
          "action": "从隔离 B0 稳定读取至少 24 本有效书",
          "checkpoint": "S1"
        },
        {
          "action": "创建 test-only 手动书单并确认目标关系为空",
          "targetAlias": "targetCollection",
          "checkpoint": "S2"
        },
        {
          "action": "每本使用 16 线程起跑闸门同时调用真实 addBooksToCollectionList，断言每本恰好一条关系",
          "targetAlias": "selectedActiveBooks",
          "checkpoint": "S3"
        },
        {
          "action": "host force-stop、创建 resume marker 后冷启动读取并再次断言每本恰好一条关系",
          "checkpoint": "S4"
        }
      ]
    },
    "ios": {
      "entry": "同一关系唯一语义的 Repository 并发测试",
      "steps": [
        {
          "action": "从同一 B0 副本稳定读取等价有效书集合",
          "checkpoint": "S1"
        },
        {
          "action": "创建隔离的 test-only 手动书单",
          "targetAlias": "targetCollection",
          "checkpoint": "S2"
        },
        {
          "action": "使用等价并发参数，断言每本恰好一条关系且调用无错误",
          "targetAlias": "selectedActiveBooks",
          "checkpoint": "S3"
        },
        {
          "action": "终止 App 后以同一副本冷启动检查关系计数稳定",
          "checkpoint": "S4"
        }
      ]
    }
  },
