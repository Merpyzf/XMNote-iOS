  "oracle": {
    "currentOracle": "Android 24 本书在 16 worker 并发调用下，每个 collection_id+book_id 恰好保留一条有效关系，调用错误数为零，Room 重开及冷启动后计数稳定。",
    "desiredSemantics": "同一 collection_id+book_id 在数据库层最多存在一条有效关系；Repository 的并发重试应通过唯一约束与原子冲突策略实现幂等。",
    "semanticProjections": [
      {
        "name": "stress-covered-book-count",
        "description": "至少拥有一条有效目标关系的不同书籍数量",
        "sql": "SELECT COUNT(*) AS covered_book_count FROM (SELECT book_id FROM collection_book WHERE collection_id = 9088101 AND is_deleted = 0 GROUP BY book_id)",
        "mode": "scalar",
        "columns": [
          {
            "name": "covered_book_count"
          }
        ],
        "parameters": {},
        "compareAndroidIOSAfter": false,
        "expected": {
          "androidBefore": 0,
          "iosBefore": 0,
          "androidAfter": 24
        }
      },
      {
        "name": "stress-relation-count-histogram",
        "description": "按每本有效关系数聚合，完成后只能存在 1×24 的唯一分布",
        "sql": "SELECT relation_count, COUNT(*) AS book_count FROM (SELECT book_id, COUNT(*) AS relation_count FROM collection_book WHERE collection_id = 9088101 AND is_deleted = 0 GROUP BY book_id) GROUP BY relation_count ORDER BY relation_count",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "relation_count"
          },
          {
            "name": "book_count"
          }
        ],
        "parameters": {},
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": [],
          "iosBefore": [],
          "androidAfter": [
            [
              1,
              24
            ]
          ],
          "iosAfter": [
            [
              1,
              24
            ]
          ]
        }
      },
      {
        "name": "stress-extra-relation-count",
        "description": "超出每本一条的有效关系总数必须为零",
        "sql": "SELECT COALESCE(SUM(relation_count - 1), 0) AS extra_relation_count FROM (SELECT book_id, COUNT(*) AS relation_count FROM collection_book WHERE collection_id = 9088101 AND is_deleted = 0 GROUP BY book_id)",
        "mode": "scalar",
        "columns": [
          {
            "name": "extra_relation_count"
          }
        ],
        "parameters": {},
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": 0,
          "iosBefore": 0,
          "androidAfter": 0,
          "iosAfter": 0
        }
      }
    ]
  },
