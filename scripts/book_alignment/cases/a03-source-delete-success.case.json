  },
  "runtimeProfile": {
    "sha256": "${RUNTIME_PROFILE_SHA256}",
    "requiredSettings": []
  },
  "aliases": [
    {
      "name": "firstBook",
      "entity": "book",
      "description": "操作前指向 targetSource 的第一本有效书",
      "requirements": [
        "is_deleted=0",
        "source_id=targetSource",
        "id 小于 secondBook"
      ],
      "selector": "active-book"
    },
    {
      "name": "secondBook",
      "entity": "book",
      "description": "操作前指向 targetSource 的第二本有效书",
      "requirements": [
        "is_deleted=0",
        "source_id=targetSource",
        "id 大于 firstBook"
      ],
      "selector": "active-book"
    },
    {
      "name": "targetSource",
      "entity": "source",
      "description": "用户确认删除的有效来源",
      "requirements": [
        "is_deleted=0",
        "id!=defaultSource"
      ]
    },
    {
      "name": "defaultSource",
      "entity": "source",
      "description": "接收原引用的系统默认来源",
      "requirements": [
        "系统根来源",
        "id!=targetSource"
      ]
    }
  ],
  "intent": {
    "summary": "删除被两本书引用的来源并把引用迁移到系统默认来源",
    "selectionScope": "single",
    "confirmation": "destructive-required",
    "outcome": "committed",
    "repeatTrigger": "single-commit",
    "selectedAliases": [
      "targetSource"
    ]
  },
  "adapters": {
    "android": {
      "entry": "来源管理页单项删除入口",
      "steps": [
        {
          "action": "打开来源管理并稳定读取",
          "checkpoint": "S1"
        },
        {
          "action": "选择被两本书引用的来源",
          "checkpoint": "S2"
        },
        {
          "action": "确认删除",
          "checkpoint": "S3"
        },
        {
          "action": "host force-stop 后冷启动读取",
          "checkpoint": "S4"
        }
      ]
    },
    "ios": {
      "entry": "原生来源管理单项删除入口",
      "steps": [
        {
          "action": "打开来源管理并稳定读取",
          "checkpoint": "S1"
        },
        {
          "action": "选择被两本书引用的来源",
          "checkpoint": "S2"
        },
        {
          "action": "确认删除",
          "checkpoint": "S3"
        },
        {
          "action": "host 终止 App 后冷启动读取",
          "checkpoint": "S4"
        }
      ]
    }
  },
  "database": {
