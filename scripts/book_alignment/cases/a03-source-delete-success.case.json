  "setup": {
    "mode": "none"
  },
  "oracle": {
    "currentOracle": "全部有效书引用在同一事务内迁移到系统默认来源，随后物理删除目标来源；失败时完整回滚。",
    "desiredSemantics": "全部有效书引用在同一事务内迁移到系统默认来源，随后物理删除目标来源；失败时完整回滚。",
    "semanticProjections": [
      {
        "name": "selected-book-sources-after-delete",
        "description": "两本书最终都引用系统默认来源",
        "sql": "SELECT id AS book_id, source_id FROM book WHERE id IN (:firstBook, :secondBook) ORDER BY id",
        "mode": "ordered-rows",
        "columns": [
          {
            "name": "book_id",
            "aliasEntity": "book"
          },
          {
            "name": "source_id",
            "aliasEntity": "source"
          }
        ],
        "parameters": {
          "firstBook": {
            "binding": "firstBook"
          },
          "secondBook": {
            "binding": "secondBook"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": [
            {
              "book_id": "firstBook",
              "source_id": "targetSource"
            },
            {
              "book_id": "secondBook",
              "source_id": "targetSource"
            }
          ],
          "iosBefore": [
            {
              "book_id": "firstBook",
              "source_id": "targetSource"
            },
            {
              "book_id": "secondBook",
              "source_id": "targetSource"
            }
          ],
          "androidAfter": [
            {
              "book_id": "firstBook",
              "source_id": "defaultSource"
            },
            {
              "book_id": "secondBook",
              "source_id": "defaultSource"
            }
          ],
          "iosAfter": [
            {
              "book_id": "firstBook",
              "source_id": "defaultSource"
            },
            {
              "book_id": "secondBook",
              "source_id": "defaultSource"
            }
          ]
        }
      },
      {
        "name": "target-source-physical-row-count",
        "description": "两端均物理删除目标来源",
        "sql": "SELECT COUNT(*) AS row_count FROM source WHERE id = :targetSource",
        "mode": "scalar",
        "columns": [
          {
            "name": "row_count"
          }
        ],
        "parameters": {
          "targetSource": {
            "binding": "targetSource"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": 1,
          "iosBefore": 1,
          "androidAfter": 0,
          "iosAfter": 0
        }
      },
      {
        "name": "target-source-active-count",
        "description": "两端有效来源投影均不再包含目标来源",
        "sql": "SELECT COUNT(*) AS active_count FROM source WHERE id = :targetSource AND is_deleted = 0",
        "mode": "scalar",
        "columns": [
          {
            "name": "active_count"
          }
        ],
        "parameters": {
          "targetSource": {
            "binding": "targetSource"
          }
        },
        "compareAndroidIOSAfter": true,
        "expected": {
          "androidBefore": 1,
          "iosBefore": 1,
          "androidAfter": 0,
          "iosAfter": 0
        }
      }
    ]
  },
