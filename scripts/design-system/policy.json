  "rules": [
    {
      "id": "DS001",
      "title": "生产字体必须使用排版 token",
      "enforcement": "enforced",
      "reason": "固定系统字号绕过 Dynamic Type 与 XMNote 排版层级。",
      "correctPath": "生产文本使用 AppTypography 或由它组合出的 feature typography token；SF Symbol 等 Image glyph 按图标语义管理"
    },
    {
      "id": "DS002",
      "title": "布局间距必须具有语义",
      "enforcement": "enforced",
      "reason": "散落的 padding、stack spacing 与 line spacing 无法稳定复用或审计。",
      "correctPath": "Spacing；仅已证明跨场景的尺寸才晋升为公共 token"
    },
    {
      "id": "DS003",
      "title": "颜色构造集中管理",
      "enforcement": "enforced",
      "reason": "直接构造颜色会绕过浅色/深色、对比度与语义状态。",
      "correctPath": "Color 语义成员或 DesignSystem/ColorConstruction.swift"
    },
    {
      "id": "DS004",
      "title": "表面圆角必须使用 token",
      "enforcement": "enforced",
      "reason": "数字圆角会造成相似页面的轮廓漂移。",
      "correctPath": "CornerRadius，并为 RoundedRectangle 保留 continuous style"
    },
    {
      "id": "DS005",
      "title": "应用滚动容器始终回弹",
      "enforcement": "enforced",
      "reason": "短内容与长内容应保持一致的 iOS 物理反馈。",
      "correctPath": ".scrollBounceBehavior(.always) 或 UIKit 对应轴 alwaysBounce… = true"
    },
    {
      "id": "DS006",
      "title": "中心弹窗使用 XMSystemAlert",
      "enforcement": "enforced",
      "reason": "多套中心弹窗实现会分裂按钮语义、颜色与行为。",
      "correctPath": "XMSystemAlert"
    },
    {
      "id": "DS007",
      "title": "Domain 不依赖 UI 框架",
      "enforcement": "enforced",
      "reason": "领域模型承载 Color 或 UIKit 类型会形成反向依赖。",
      "correctPath": "领域层保留纯值；颜色与图标映射放在 UIComponents 或 Views"
    },
    {
      "id": "DS008",
      "title": "UIComponents 依赖方向审查",
      "enforcement": "enforced",
      "reason": "公共 UI 持有 Repository 或 ViewModel 会成为业务状态 owner，并形成反向依赖。",
      "correctPath": "Repository 与业务编排归属 ViewModels/Feature；UIComponents 只接收纯展示值与动作"
    },
    {
      "id": "DS009",
      "title": "点击交互语义审查",
      "enforcement": "enforced",
      "reason": "普通点击使用手势会丢失原生控件语义；复杂手势需要精确、可失效的例外。",
      "correctPath": "优先 Button、Toggle、NavigationLink；确属复杂手势时登记声明级例外和可访问性替代"
    },
    {
      "id": "DS010",
      "title": "44pt 交互 token 唯一 owner 审查",
      "enforcement": "enforced",
      "reason": "重复声明 44pt 会使点击区规范漂移，并可能把视觉尺寸与交互尺寸混为一谈。",
      "correctPath": "InteractionMetrics.minimumTouchTarget；视觉尺寸保持由组件真实布局 owner 管理"
    },
    {
      "id": "DS011",
      "title": "组件目录与分层覆盖审查",
      "enforcement": "enforced",
      "reason": "未登记或错层组件无法被可靠发现、预览、复用和迁移。",
      "correctPath": "component-catalog.json schema v3；每个非 Vendor UIComponents 文件登记类别、层级、复用范围、状态、边界与 Preview 策略"
    },
    {
      "id": "DSR001",
      "title": "字面量 SF Symbol 语义审查",
      "enforcement": "report",
      "reason": "图标名称本身不一定构成债务，但重复语义需要集中 owner。",
      "correctPath": "优先复用已存在的图标组件；独立单点可保留局部字面量"
    },
    {
      "id": "DSR002",
      "title": "动画时长语义审查",
      "enforcement": "report",
      "reason": "局部时长可以合理，但跨场景重复值需要 motion owner。",
      "correctPath": "先证明相同结构变化与时序，再提取运动 token"
    },
    {
      "id": "DSR003",
      "title": "裸 ProgressView 使用审查",
      "enforcement": "report",
      "reason": "读取主态受 LoadingGate 约束，局部进度或写入反馈可能仍合理。",
      "correctPath": "根据读取、写入或局部进度语义选择 LoadingGate、LoadingStateView 或保留局部 ProgressView"
    },
    {
      "id": "DSR004",
      "title": "操作按钮前景—背景配对审查",
      "enforcement": "report",
      "reason": "原生按钮样式会消费环境 tint；品牌前景与品牌弱填充可能同时出现，突出按钮也需要实际对比度证据。",
      "correctPath": "按按钮角色显式选择品牌填充与中性前景、中性次级配对或反馈语义，并验证浅色、深色和高对比度"
    }
  ]
