  "interactionPolicy": {
    "tapGestureRuleID": "DS009",
    "touchTargetRuleID": "DS010",
    "touchTargetOwnerPath": "xmnote/Utilities/DesignSystem/InteractionMetrics.swift",
    "touchTargetLiteral": 44,
    "touchTargetNameFragments": [
      "touch",
      "hit",
      "tap",
      "button",
      "control",
      "action"
    ],
    "gestureExceptions": [
      {
        "path": "xmnote/UIComponents/Charts/HeatmapChart.swift",
        "declaration": "HeatmapChart.squareView",
        "reason": "热力格属于连续二维数据图中的精确点选，不是独立列表按钮",
        "owner": "Charts/Reading",
        "accessibilityAlternative": "每个日期格提供日期与阅读数据标签、按钮 trait 和显式 accessibilityAction",
        "visualFreezeRationale": "把每个密集方格扩展到 44pt 会造成相邻目标重叠并改变热力图密度与宽度"
      },
      {
        "path": "xmnote/RichTextEditor/HighlightColorPicker.swift",
        "declaration": "HighlightColorPicker.colorDot",
