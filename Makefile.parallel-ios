PARALLEL_IOS_SCRIPTS ?= scripts/parallel-ios

.PHONY: ai-doctor ai-task-create ai-task-init ai-task-destroy ai-prepare ai-resolve ai-build \
	ai-ui-lint ai-ui-lint-all ai-ui-lint-test ai-test ai-test-build ai-test-run ai-run ai-screenshot

ai-doctor:
	@$(PARALLEL_IOS_SCRIPTS)/doctor.zsh

ai-task-create:
	@test -n "$(TASK)" || (echo "Usage: make ai-task-create TASK=my-task [BASE=<ref>]" >&2; exit 2)
	@$(PARALLEL_IOS_SCRIPTS)/task-create.zsh "$(TASK)" "$(BASE)"

ai-task-init:
	@$(PARALLEL_IOS_SCRIPTS)/task-init.zsh "$(TASK)"

ai-task-destroy:
	@$(PARALLEL_IOS_SCRIPTS)/task-destroy.zsh "$(TASK)"

ai-prepare:
	@$(PARALLEL_IOS_SCRIPTS)/prepare.zsh

ai-resolve:
	@$(PARALLEL_IOS_SCRIPTS)/resolve-packages.zsh

ai-build:
	@$(PARALLEL_IOS_SCRIPTS)/build.zsh

ai-ui-lint:
	@PYTHONDONTWRITEBYTECODE=1 python3 scripts/design-system/ds.py lint --changed

ai-ui-lint-all:
	@PYTHONDONTWRITEBYTECODE=1 python3 scripts/design-system/ds.py audit

ai-ui-lint-test:
	@PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover \
		-s scripts/design-system/tests \
		-p 'test_*.py'
	@mkdir -p artifacts/design-system/module-cache
	@CLANG_MODULE_CACHE_PATH="$(CURDIR)/artifacts/design-system/module-cache" \
		SWIFTPM_MODULECACHE_OVERRIDE="$(CURDIR)/artifacts/design-system/module-cache" \
		swift test --disable-sandbox \
		--package-path scripts/design-system/ui-lint \
		--scratch-path artifacts/design-system/swiftpm

ai-test:
	@ONLY_TESTING="$(ONLY_TESTING)" $(PARALLEL_IOS_SCRIPTS)/test.zsh test

ai-test-build:
	@$(PARALLEL_IOS_SCRIPTS)/test.zsh build-for-testing

ai-test-run:
	@ONLY_TESTING="$(ONLY_TESTING)" $(PARALLEL_IOS_SCRIPTS)/test.zsh test-without-building

ai-run:
	@$(PARALLEL_IOS_SCRIPTS)/run.zsh

ai-screenshot:
	@$(PARALLEL_IOS_SCRIPTS)/screenshot.zsh "$(FILE)"
