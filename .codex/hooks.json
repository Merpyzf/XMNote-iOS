{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/ai-knowledge/kb.py\" hook session-start",
            "timeout": 10,
            "statusMessage": "检查本地 Bug 草稿与复审状态"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/ai-knowledge/kb.py\" hook user-prompt",
            "timeout": 10,
            "statusMessage": "建立任务工作树基线"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/ai-knowledge/kb.py\" hook pre-tool-use",
            "timeout": 20,
            "statusMessage": "检索相关 Bug 经验"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/xmnote-git-commit/scripts/commit_gate.py\" hook pre-tool-use",
            "timeout": 20,
            "statusMessage": "验证 Git 提交 PASS 凭据"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/xmnote-git-commit/scripts/commit_gate.py\" hook post-tool-use",
            "timeout": 20,
            "statusMessage": "消费 Git 提交 PASS 凭据"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/ai-knowledge/kb.py\" hook stop",
            "timeout": 10,
            "statusMessage": "检查 Bug 事实闭环"
          }
        ]
      }
    ]
  }
}
